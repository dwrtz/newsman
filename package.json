{
  "name": "newsman",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "worker-build --release --locked",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "cargo test --locked && node --test --test-concurrency=1 test/worker.test.mjs test/editorial.test.mjs test/audience.test.mjs test/delivery.test.mjs",
    "test:parity": "node --test test/worker.test.mjs",
    "test:e2e": "node --test test/browser.test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:deploy": "cf deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cf": "1.0.0-rc.5",
    "miniflare": "5.20261117.0-beta",
    "playwright-core": "1.65.1",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
